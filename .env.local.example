# SOUND·TRADE 環境変数テンプレート
# 値を埋めて .env.local にコピーしてください（.env.local は Git 管理外）。

# --- Supabase ---
# プロジェクト URL（例: https://xxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# 公開可能な anon key（ブラウザから利用可）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 管理者用 service_role key（サーバー側のみ・RLS バイパス・絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Resend ダッシュボードで発行した API キー。空のままだとメール送信は黙ってスキップされる。
RESEND_API_KEY=
# 送信元アドレス（ドメイン認証済みでない場合は onboarding@resend.dev で検証用送信のみ可）
# 例: "SOUND·TRADE <noreply@sound-trade.jp>"
RESEND_FROM_EMAIL=
# 管理者通知の宛先（カンマ区切り）。未設定なら admin_users の super_admin/admin 全員に送る。
RESEND_ADMIN_EMAILS=

# --- Analytics (GA4) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- SEO ---
# サイトのベース URL（末尾スラッシュなし）。sitemap.xml / OGP / canonical で使用。
# 未設定なら http://localhost:3000 にフォールバック。本番は実ドメインを入れる。
NEXT_PUBLIC_SITE_URL=
